
# Copy this file to .env and fill in the real values.
# Never commit the real .env — it contains secrets.

# MySQL database
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_NAME=system180_db

# Session/signing secret of the webapp
SECRET_KEY=change-me

# Neo4j Aura knowledge graph
NEO4J_URI=neo4j+s://XXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# HERE geocoding API (transport/resource-efficiency dashboards)
HERE_API_KEY=change-me

# Label Studio (labeling & retraining pipeline)
# Export endpoint of the annotation project; {id} is replaced by PROJECT_ID.
LABEL_STUDIO_API_URL=http://localhost:8082/api/projects/{id}/export?exportType=JSON
# Access token: Label Studio -> Account & Settings -> Access Token
LABEL_STUDIO_API_KEY=
PROJECT_ID=4
# Optional: base URL of the Label Studio UI for the /training admin page.
# Defaults to scheme+host of LABEL_STUDIO_API_URL if unset.
#LABEL_STUDIO_BASE_URL=http://localhost:8082
# Optional: local media upload dir of Label Studio (legacy local training).
# Defaults to the platform-specific Label Studio app-data directory.
#LABEL_STUDIO_MEDIA_DIR=

# Optional: root of the shared local-files storage (docker compose mounts
# ./training_captures here in both containers).
#LABEL_STUDIO_FILES_ROOT=/label-studio/files
# Optional: model for the "Nubs" labeling project (webapp/model/).
#NUBS_MODEL_NAME=NubsUpDown.pt
# Optional: damage model (Kratzer/Dellen/MDF-Platzer). Usually managed via
# the /training page (upload + activate); this is only the fallback name.
#SCHADEN_MODEL_NAME=schaeden.pt

# Default YOLO model file inside webapp/model/. Only a fallback: the active
# version is set on the /training page (drag & drop upload) and stored in
# config/models.json.
MODEL_NAME=my_custom_model.pt
# Optional: where ultralytics stores training runs (legacy local training).
# Defaults to the ultralytics settings runs_dir + /detect.
#RUNS_DIR=
